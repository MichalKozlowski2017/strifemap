# Database — Turso (production) or leave unset for local SQLite fallback:
# file:./data/warnews.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# OpenAI (optional — extract/sitrep skip gracefully without key)
OPENAI_API_KEY=
# Optional: gpt-4o-mini default; use Ollama via OpenAI-compatible base URL
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Cron protection (required in production)
CRON_SECRET=change-me

# Panel admin password (HttpOnly session cookie). Required to open /panel.
PANEL_PASSWORD=change-me-strong

# Raw body retention after processed (days, 3–7)
RAW_BODY_RETENTION_DAYS=5
